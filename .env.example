# Alle verdier er EGNE for dette prosjektet. Ingen skal være den samme som i
# TinkrFlows — hele poenget med utskillingen er at installasjonene ikke deler
# legitimasjon.

# Supabase-prosjektet som holder ssb_datasett og ssb_kilder
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sperre foran GET /api/ssb/refresh. Navnet er arvet fra TinkrFlows; det
# finnes ingen cron her.
CRON_SECRET=

# Nøkkelen /admin spør etter
FINNMARK_ADMIN_KEY=
