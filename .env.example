# Alle verdier er EGNE for dette prosjektet. Ingen skal være den samme som i
# TinkrFlows — hele poenget med utskillingen er at installasjonene ikke deler
# legitimasjon.

# Supabase-prosjektet som holder ssb_datasett, ssb_kilder og brukerroller
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-postadressen som får superadministrator-rollen ved første innlogging.
# Fjern eller tøm variabelen etter at første superadministrator er opprettet.
FINNMARK_BOOTSTRAP_SUPERADMIN_EMAIL=
